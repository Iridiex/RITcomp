# Copy this file to .env and paste your key from https://aistudio.google.com/apikey
# Without a key the urgency check is switched off.
GEMINI_API_KEY=
# Optional: any Gemini model id
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: model that turns drivers' voice notes into text
GEMINI_SPEECH_MODEL=gemini-3.5-flash
GEMINI_ASSISTANT_MODEL=gemini-3.5-flash
